generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String // ADMIN, SALES, WAREHOUSE, ACCOUNTS
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  mobile       String
  email        String?
  businessName String?
  gst          String?
  type         String // RETAIL, WHOLESALE, DISTRIBUTOR
  address      String?
  status       String    @default("LEAD") // LEAD, ACTIVE, INACTIVE
  followUpDate DateTime?
  notes        String?
  challans     Challan[]
}

model Product {
  id           Int             @id @default(autoincrement())
  name         String
  sku          String          @unique
  category     String
  unitPrice    Float
  currentStock Int             @default(0)
  minStock     Int             @default(10)
  location     String?
  imageUrl     String?
  movements    StockMovement[]
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  type      String // IN, OUT
  reason    String
  createdBy String
  timestamp DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Challan {
  id         Int           @id @default(autoincrement())
  challanNo  String        @unique
  customerId Int
  status     String        @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  totalQty   Int
  createdBy  String
  createdAt  DateTime      @default(now())
  customer   Customer      @relation(fields: [customerId], references: [id])
  items      ChallanItem[]
}

model ChallanItem {
  id            Int     @id @default(autoincrement())
  challanId     Int
  productId     Int
  quantity      Int
  snapshotName  String
  snapshotSku   String
  snapshotPrice Float
  challan       Challan @relation(fields: [challanId], references: [id])
}
